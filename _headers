# Netlify: cuánto guarda el navegador cada cosa y dos cabeceras de seguridad básicas.
# Los videos y las fuentes casi no cambian; si se reemplaza un video con el
# mismo nombre, el navegador lo vuelve a pedir a los 7 días como mucho.
/videos/*
  Cache-Control: public, max-age=604800
/fuentes/*
  Cache-Control: public, max-age=2592000
/img/*
  Cache-Control: public, max-age=604800
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
